{
  "name": "compartilhar-tela-collab",
  "version": "1.0.0",
  "description": "App de Compartilhamento de Tela com Audio de Aplicação (WASAPI Loopback)",
  "main": "main.js",
  "scripts": {
    "start": "electron . --disable-gpu --disable-gpu-compositing --no-sandbox",
    "dev": "electron . --dev",
    "rebuild": "node-gyp rebuild",
    "build:win": "npm install node-addon-api node-gyp --no-save && node-gyp rebuild && electron-builder --win",
    "build:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "livekit-server-sdk": "^2.1.0"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.screenshare.collab",
    "files": [
      "main.js",
      "preload.js",
      "public/**/*",
      "build/Release/wasi_audio.node"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
