{
  "name": "compartilhar-tela-collab",
  "version": "1.0.1",
  "description": "App de Compartilhamento de Tela com Audio de Aplicação (WASAPI Loopback)",
  "main": "main.js",
  "scripts": {
    "start": "electron . --disable-gpu --disable-gpu-compositing --no-sandbox",
    "dev": "electron . --dev",
    "rebuild": "node -e \"console.error('Desativado: use npm run build:native:electron:isolated (saida fora do repo) e promova o addon com backup, ver HANDOFF.md'); process.exit(1)\"",
    "build:native:electron:isolated": "node scripts/build-native-electron-isolated.js",
    "prebuild:win": "node scripts/check-addon.js",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "livekit-server-sdk": "^2.1.0"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^12.3.0"
  },
  "build": {
    "appId": "com.screenshare.collab",
    "npmRebuild": false,
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "main.js",
      "preload.js",
      "public/**/*",
      "build/Release/wasi_audio.node"
    ],
    "asarUnpack": [
      "build/Release/*.node"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
